# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the ElderAI chat and SOS routes (both require a staff/admin login).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (family chat, ElderAI, translations) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
AI_GROQ_TOKEN_THRESHOLD=8000

# --- Twilio (SOS SMS / WhatsApp / voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --- Care home ---
CARE_HOME_NAME=ElderLink Care Home
CARE_HOME_PHONE=
# Calendar days ("today", shifts) are counted in this zone.
CARE_HOME_TIMEZONE=Asia/Kolkata

# --- Demo mode ---
# care_logs_demo rows with entry_source='demo' are seeded demonstration data.
# Set to true to include them in Early Warning, Behaviour Analysis, Handover
# and the family chatbot (every screen then shows a DEMO notice).
ELDERLINK_INCLUDE_DEMO_DATA=false
